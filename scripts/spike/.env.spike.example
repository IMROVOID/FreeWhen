# scripts/spike/.env.spike.example
#
# Copy to .env.spike and fill in. Never commit .env.spike — scripts/spike/.gitignore
# keeps it out, and a leaked key in a spike transcript is a real leak
# (PRD-08 §15, docs/plans/00-de-risk-spike.plan.md LOG_REDACTION).
#
#   cp scripts/spike/.env.spike.example scripts/spike/.env.spike
#
# Every value below is a placeholder. None of them is a working credential.

# --- Where the checks point ------------------------------------------------
# Real vendors by default; override only to test the script itself.
# NESHAN_BASE=https://api.neshan.org

# --- 0.2 / 0.3  Neshan -----------------------------------------------------
# Keys are PER-SERVICE scoped. A directions key returns 483 against the matrix
# endpoint, so provision one key per service you intend to measure
# (docs/research/01-RESOLVED-ANSWERS.md Q2).
NESHAN_API_KEY=

# Two real Tehran points. Tajrish -> Azadi, ~15 km by road.
# Coordinates are NOT recorded in the report — only status codes and counts.
SPIKE_ORIGIN=35.7448,51.3756
SPIKE_DESTINATION=35.6997,51.3380

# Override only if measuring a raster source instead of Neshan vector tiles.
# NESHAN_TILE_URL=

# --- 0.4  Self-hosted Supabase --------------------------------------------
# Set by setup.sh on the VPS. The URL is public; the keys are not.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. The spike does not need it; listed so it is never confused with
# the publishable key above.
# SUPABASE_SECRET_KEY=

# Throwaway password for the signup write-path probe.
SPIKE_PROBE_PASSWORD=

# --- 0.6  Stack health over SSH -------------------------------------------
SPIKE_SSH=
SPIKE_COMPOSE=/srv/supabase/docker-compose.yml

# --- 0.1  VPS sizing -------------------------------------------------------
# Set to 1 ONLY when this script runs on the VPS itself. Otherwise check 0.1
# abstains rather than measuring whatever machine happens to run it.
# SPIKE_IS_VPS=1

# Accept a self-signed certificate. Only for a fixture run; a real measurement
# over SPIKE_INSECURE proves nothing about the certificate chain.
# SPIKE_INSECURE=1

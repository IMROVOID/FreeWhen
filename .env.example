# FreeWhen — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored (see .gitignore); this file
# documents the SHAPE only and must never contain a working credential.
#
# The client bundle and the server are separated by variable NAME, not by
# convention: anything named *_KEY / *_SECRET / *_TOKEN below is server-only
# and `npm run gate:secrets` fails the build if one reaches the bundle.
#
# PRD-10 §8 (secrets) · PRD-13 §7 (release gates) · PRD-08 (privacy).

# --- Client (safe by design) -------------------------------------------------
# EXPO_PUBLIC_* values are INLINED AT BUILD TIME by the bundler. A key that
# only exists on the host never reaches the bundle — and one that exists in
# the build shell does. That is exactly why `gate:web` scans dist/.

# Self-hosted Supabase. The publishable key is RLS-protected by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public Mapbox token, restricted to the app package in the Mapbox console.
# A `pk.` token in the bundle is CORRECT. A `sk.` token there is a leak and
# `gate:web` fails on it.
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# Public tile style URL (PRD-13 §7).
EXPO_PUBLIC_TILE_STYLE_URL=

# Base URL used to build invite links (PRD-01 FR-1.14).
EXPO_PUBLIC_APP_BASE_URL=

# The demo invite token `/start` routes to (PRD-13 §6.2).
#
# ★ INLINED AT EXPORT TIME, SO IT MUST BE IN THE BUILD SHELL.
#
# A value set only on the host produces a bundle whose `/start` renders the
# "not configured" state, which is why `gate:web` scans the built output.
#
# The token must be a STABLE literal that resolves to the seeded `is_demo`
# event — never minted through the UI, or it rotates on the next reseed and
# `/start` breaks silently. The seed's token for the fixture event is
# `freewhen-test-invite-token`.
EXPO_PUBLIC_DEMO_TOKEN=

# --- Server only (NEVER in a client bundle) ----------------------------------
# Declared here so the shape is documented. These are read by the server
# layer, not by the app. `gate:secrets` scans src/, server/ and dist/ for
# these names and fails if a value appears in a client artifact.

# Supabase service-role equivalent. Full RLS bypass — catastrophic if leaked.
SUPABASE_SECRET_KEY=

# PostgREST + the local token service signer. One shared value.
JWT_SECRET=

# Neshan (routing, geocoding, matrix). Iranian, Toman-payable.
#
# ★ NESHAN KEYS ARE PER-SERVICE. A directions key sent to the matrix
# endpoint returns 483 ApiKeyTypeError, so the two services are read from
# two variables. `NESHAN_API_KEY` below still works as a fallback for both
# — the per-service variable wins when it is set.
NESHAN_API_KEY=
NESHAN_MATRIX_API_KEY=
NESHAN_DIRECTION_API_KEY=

# OpenRouteService (self-hosted fallback). ToS requires server-side only.
ORS_API_KEY=

# Optional AI provider. Absent = deterministic-only, still fully functional.
AI_PROVIDER_KEY=

# Postgres password for the local-Postgres backend (D22).
# Also read by docker-compose.local.yml. The Compose file refuses to
# start without it, rather than falling back to a default — a default
# password in a Compose file is a credential in the source tree.
POSTGRES_PASSWORD=

# Postgres user and database for the local backend. These are names, not
# credentials, and they default to the compose file's own defaults.
POSTGRES_USER=postgres
POSTGRES_DB=freewhen

# --- Backend selection -------------------------------------------------------
# `supabase` (default) or `local_pg` (plain PostgreSQL + PostgREST, D22).
#
# ★ AN UNKNOWN VALUE IS A STARTUP FAILURE, not a fallback to the default.
# A typo would otherwise silently select the default backend, and the host
# would serve the Supabase paths while the operator believed they had
# deployed the local one.
DATABASE_BACKEND=supabase

# --- Local backend, server only -----------------------------------------------
# The variables below are read ONLY by the local backend's two processes:
# the auth service (`npm run server:auth`) and the realtime bridge
# (`npm run server:realtime`). On the Supabase backend they are ignored.

# The database the local backend talks to. Required by both processes —
# a default would silently connect to the wrong database when the
# variable is mistyped.
DATABASE_URL=

# Where the auth service listens. The Caddyfile routes `/auth/v1/*` here.
AUTH_PORT=8789

# Where the realtime bridge listens. The Caddyfile routes
# `/realtime/v1/*` here.
REALTIME_PORT=8788

# The anonymous sign-in limit, per hour per IP. FR-8.35's default is 30.
#
# ★ CONFIGURABLE, and the reason is practical: a demo behind one NAT
# address has every attendee behind one IP, and 30 requests an hour is
# not enough for a room of people joining at once. Raise it for a demo;
# leave it at the default for a public host.
ANON_SIGNIN_LIMIT_PER_HOUR=30

# The anonymous token lifetime, in seconds. The default is one hour.
# PostgREST validates `exp` with a 30-second skew, so a non-expiring
# token would defeat a check that already exists.
ANON_TOKEN_TTL_SECONDS=3600

# FreeWhen — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored (see .gitignore); this file
# documents the SHAPE only and must never contain a working credential.
#
# The client bundle and the server are separated by variable NAME, not by
# convention: anything named *_KEY / *_SECRET / *_TOKEN below is server-only
# and `npm run gate:secrets` fails the build if one reaches the bundle.
#
# PRD-10 §8 (secrets) · PRD-13 §7 (release gates) · PRD-08 (privacy).

# --- Client (safe by design) -------------------------------------------------
# EXPO_PUBLIC_* values are INLINED AT BUILD TIME by the bundler. A key that
# only exists on the host never reaches the bundle — and one that exists in
# the build shell does. That is exactly why `gate:web` scans dist/.

# Self-hosted Supabase. The publishable key is RLS-protected by design.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The MapBox public token — the ONLY map credential this app has.
#
# ★ A `pk.` TOKEN IN THE BUNDLE IS CORRECT. AN `sk.` TOKEN IS A LEAK.
#
# The token is scoped to a URL pattern in the MapBox console and appears in every
# tile and static-image request the browser makes, so it is publishable by design —
# exactly like the Supabase publishable key. `scripts/gate/credential-shapes.ts`
# rejects the `sk.` form in any scanned text and `gate:secrets` runs before every
# export; `readMapboxToken()` also refuses a non-`pk.` value at runtime, so a
# misconfigured deploy degrades to the stated "map unavailable" state rather than
# publishing a credential.
#
# ★ IT MUST ALSO BE IN THE EXPORT SHELL.
#
# `EXPO_PUBLIC_*` is substituted by the bundler, so a value that exists only on the
# host is inlined as an empty string: every map then renders the unavailable state
# on every device, with nothing in any log. `deploy.yml`, `ci.yml` and
# `release-apk.yml` each pass it into their bundler shell, and `gate:env` fails the
# build when it is missing.
#
# Plan 64 replaced the previous basemap provider entirely. There is no basemap key any more.
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# Which renderer the map ladder should prefer. Optional: a `pk.` token alone is
# enough for MapBox, so an operator who never sets this still gets a map.
EXPO_PUBLIC_MAP_PROVIDER=

# A full tile style URL, overriding the shared light/dark pair in
# `src/features/map/mapbox-token.ts` (PRD-13 §7).
EXPO_PUBLIC_TILE_STYLE_URL=

# Base URL used to build invite links (PRD-01 FR-1.14).
#
# ★ THIS IS ALSO THE API ORIGIN, AND THAT IS NOT A COINCIDENCE.
#
# The API is served same-origin behind Caddy (`handle /api/*`), so the app's own
# public origin IS the API origin. `src/lib/api-base-url.ts` resolves
# `EXPO_PUBLIC_API_URL` first and then this, so a deployment that sets only this
# one still reaches its backend. Before that fallback existed a release APK built
# from the documented variables shipped pointing at `127.0.0.1:8787` — the phone
# itself — and opened to a spinner.
EXPO_PUBLIC_APP_BASE_URL=

# The API origin, when it differs from the app origin (e.g. a separate API host).
# Leave blank in the single-origin deployment this repository targets.
EXPO_PUBLIC_API_URL=

# The demo invite token `/start` routes to (PRD-13 §6.2).
#
# ★ INLINED AT EXPORT TIME, SO IT MUST BE IN THE BUILD SHELL.
#
# A value set only on the host produces a bundle whose `/start` renders the
# "not configured" state, which is why `gate:web` scans the built output.
#
# The token must be a STABLE literal that resolves to the seeded `is_demo`
# event — never minted through the UI, or it rotates on the next reseed and
# `/start` breaks silently. The seed's token for the fixture event is
# `freewhen-test-invite-token`.
EXPO_PUBLIC_DEMO_TOKEN=

# --- Server only (NEVER in a client bundle) ----------------------------------
# Declared here so the shape is documented. These are read by the server
# layer, not by the app. `gate:secrets` scans src/, server/ and dist/ for
# these names and fails if a value appears in a client artifact.

# Supabase service-role equivalent. Full RLS bypass — catastrophic if leaked.
SUPABASE_SECRET_KEY=

# PostgREST + the local token service signer. One shared value.
JWT_SECRET=

# Neshan (routing, geocoding, matrix). Iranian, Toman-payable.
#
# ★ NESHAN KEYS ARE PER-SERVICE. A directions key sent to the matrix
# endpoint returns 483 ApiKeyTypeError, so the two services are read from
# two variables. `NESHAN_API_KEY` below still works as a fallback for both
# — the per-service variable wins when it is set.
#
# ★ THEY ARE SERVER-SIDE ONLY AND MUST NEVER BECOME `EXPO_PUBLIC_*`.
#
# Place search and routing are proxied (`server/routes/place-search.ts`,
# `server/routes/rank-travel.ts`) precisely so the credential stays out of the
# bundle. A `EXPO_PUBLIC_NESHAN_*` name would publish it: `gate:secrets` fails
# the build, and `tests/deploy/map-assets.test.ts` pins the rule.
NESHAN_API_KEY=
NESHAN_MATRIX_API_KEY=
NESHAN_DIRECTION_API_KEY=

# OpenRouteService (self-hosted fallback). ToS requires server-side only.
ORS_API_KEY=

# Optional AI provider. Absent = deterministic-only, still fully functional.
AI_PROVIDER_KEY=

# Postgres password for the local-Postgres backend (D22).
# Also read by docker-compose.local.yml. The Compose file refuses to
# start without it, rather than falling back to a default — a default
# password in a Compose file is a credential in the source tree.
POSTGRES_PASSWORD=

# Postgres user and database for the local backend. These are names, not
# credentials, and they default to the compose file's own defaults.
POSTGRES_USER=postgres
POSTGRES_DB=freewhen

# --- Deploy targets (GitHub Actions) -----------------------------------------
# ★ THE SHAPE ONLY. NO WORKING VALUE BELONGS IN THIS FILE.
#
# These are consumed by `.github/workflows/deploy.yml` as repository secrets and
# variables, not by the app. `.env.example` documents them so an operator knows
# what to create; the full matrix, per target, is in
# `.github/workflows/README.md` §2 and §3.
#
# Local testing should use `.env.platforms`, which `.gitignore:3` excludes via
# `.env.*`. A credential pasted into a chat, a ticket or this file should be
# treated as exposed and rotated.

# --- PaaS ---
# Vercel. The token alone is not enough: without both ids the CLI creates a
# SECOND project, and the deploy lands somewhere nobody looks.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Netlify. The site id is optional — the API creates a site by name when absent.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# Cloudflare. A token must carry Pages:Edit AND see the account, or every
# Pages/Workers endpoint under /accounts/<id>/ is unreachable.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=

# Railway. Needs an ACCOUNT or WORKSPACE token — a project token cannot read the
# domain list, so the origin has to come from FREEWHEN_SERVER_URL instead.
RAILWAY_TOKEN=
RAILWAY_SERVICE=

# Render. `static_site` requires a connected repository; there is no directory
# upload, so the build runs on Render and EXPO_PUBLIC_* are service env vars.
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_SERVICE_ID=

# Fly.io ORGANISATION token. ★ QUOTE IT: the value is `FlyV1 <payload>,<mac>` and
# the space is part of it. Unquoted, `set -a; . .env` splits it and the failure
# reads as an auth error.
FLY_API_TOKEN=
FLY_APP=
FLY_REGION=

# --- VM / VPS ---
VPS_HOST=
VPS_USER=deploy
VPS_PATH=/srv/app
VPS_SSH_KEY=
# Required. `ssh-keyscan` only populates known_hosts from whatever answers; the
# fingerprint comparison is the verification.
VPS_SSH_HOST_FINGERPRINT=

# --- Databases ---
# Neon. The connection host is `ep-<id>.<proxy_host>`, NOT `proxy_host` — its
# certificate does not cover the bare name. A role password is resettable,
# never readable, so re-running a setup script rotates the credential.
NEON_API_KEY=
NEON_DATABASE_URL=

# Supabase management token. It manages projects and cannot connect to Postgres;
# the database password is set at creation and never returned by the API.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- Sandbox providers (build/test VMs, not app hosts) ---
# Daytona has no public HTTPS ingress to a sandbox port, so it cannot serve the
# reviewer path. FreeStyle documents itself as not for hosting production apps.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
FREESTYLE_API_KEY=

# --- Backend selection -------------------------------------------------------
# ★ THIS VARIABLE NOW ANSWERS TWO DIFFERENT QUESTIONS. Read both paragraphs.
#
# (1) WHICH DEPLOYMENT STACK (PRD-10 D22, scripts/db/backends.ts):
#   `supabase` (default) — the self-hosted Supabase 5-container stack.
#   `local_pg`           — plain PostgreSQL + PostgREST, tokens from server/auth.
#
# (2) WHICH WIRE PROTOCOL THE API SERVER USES (Plan 40, server/lib/db-backend.ts):
#   `pg`            (default) — `pg` over a TCP socket (a Pool on Node, a
#                               Client per request on Workers).
#   `supabase_rest`           — PostgREST over HTTPS. No socket, no direct
#                               Postgres credential; needs SUPABASE_URL and
#                               SUPABASE_SECRET_KEY.
#
# ★ THE TWO VOCABULARIES ARE RECONCILED, NOT MERGED.
# `supabase` and `local_pg` both describe Postgres reached over TCP, so the
# server resolves BOTH to `pg`. An existing .env with either value keeps
# booting with byte-identical behaviour — if they threw, this feature would
# break every deployment that already works.
#
# ★ AN UNKNOWN VALUE IS A STARTUP FAILURE, not a fallback to the default.
# A typo would otherwise silently serve one transport while the operator
# believed they had configured the other, and the mismatch would surface as
# a connection error in production.
DATABASE_BACKEND=supabase

# Supabase as an external DB provider (Plan 40 D2).
# Only read when DATABASE_BACKEND=supabase_rest. The base URL of the Supabase
# (or self-hosted PostgREST) project, and the service key beside it. The key is
# sent as BOTH `apikey` and `Authorization` — Supabase answers 401 to a request
# that carries only the bearer.
#
# ★ THE SERVICE KEY BYPASSES RLS ENTIRELY. Server-side only; gate:secrets
# fails the build if this name appears in client code.
SUPABASE_URL=

# --- Local backend, server only -----------------------------------------------
# The variables below are read ONLY by the local backend's two processes:
# the auth service (`npm run server:auth`) and the realtime bridge
# (`npm run server:realtime`). On the Supabase backend they are ignored.

# The database the local backend talks to. Required by both processes —
# a default would silently connect to the wrong database when the
# variable is mistyped.
DATABASE_URL=

# Where the auth service listens. The Caddyfile routes `/auth/v1/*` here.
AUTH_PORT=8789

# Where the realtime bridge listens. The Caddyfile routes
# `/realtime/v1/*` here.
REALTIME_PORT=8788

# The anonymous sign-in limit, per hour per IP. FR-8.35's default is 30.
#
# ★ CONFIGURABLE, and the reason is practical: a demo behind one NAT
# address has every attendee behind one IP, and 30 requests an hour is
# not enough for a room of people joining at once. Raise it for a demo;
# leave it at the default for a public host.
ANON_SIGNIN_LIMIT_PER_HOUR=30

# The anonymous token lifetime, in seconds. The default is one hour.
# PostgREST validates `exp` with a 30-second skew, so a non-expiring
# token would defeat a check that already exists.
ANON_TOKEN_TTL_SECONDS=3600

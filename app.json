{
  "expo": {
    "name": "FreeWhen",
    "slug": "freewhen",
    "version": "0.1.4",
    "orientation": "portrait",
    "scheme": "freewhen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#120A07"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.freewhen.app",
      "associatedDomains": ["applinks:freewhen.app"],
      "icon": {
        "light": "./assets/images/icon-light.png",
        "dark": "./assets/images/icon.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "ir.freewhen.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#120A07",
        "monochromeImage": "./assets/images/monochrome-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 5,
      "usesCleartextTraffic": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "freewhen.app",
              "pathPrefix": "/e"
            },
            {
              "scheme": "http",
              "host": "freewhen.app",
              "pathPrefix": "/e"
            },
            {
              "scheme": "https",
              "host": "freewhen.app",
              "pathPrefix": "/event"
            },
            {
              "scheme": "http",
              "host": "freewhen.app",
              "pathPrefix": "/event"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": ["fa", "en"],
            "ios": ["fa", "en"]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FreeWhen uses your approximate location only to estimate travel distance for the participants of an event you joined."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#120A07"
        }
      ],
      "./plugins/with-direction-reload.js",
      "./plugins/with-no-startup-provider.js",
      "./plugins/with-google-maps-key.js"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}

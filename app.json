{
  "expo": {
    "name": "FreeWhen",
    "slug": "freewhen",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "freewhen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#120A07"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.freewhen.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "ir.freewhen.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#120A07"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": ["fa", "en"],
            "ios": ["fa", "en"]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FreeWhen uses your approximate location only to estimate travel distance for the participants of an event you joined."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}

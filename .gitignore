# Secrets — never commit. .env.example / .env.spike.example document the shape only.
.env
.env.*
!.env.example
!.env.spike.example

# Spike transcripts may capture a live credential; the script writes none, but be safe.
docs/spike/*.log
docs/spike/*.transcript

# Supabase self-hosted (PRD-10 §7.3) — cloned on the VPS, not in this repo
/supabase/


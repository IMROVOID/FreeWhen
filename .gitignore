# Secrets — never commit. .env.example / .env.spike.example document the shape only.
.env
.env.*
!.env.example
!.env.spike.example

# Spike transcripts may capture a live credential; the script writes none, but be safe.
docs/spike/*.log
docs/spike/*.transcript

# Supabase self-hosted (PRD-10 §7.3) — cloned on the VPS, not in this repo.
# The CONTENTS are ignored, not the directory: `supabase/seed.sql` is a
# source artifact of this repo (the PRD-05 §12A fixture, applied by
# `npm run db:seed`), and a fresh clone cannot seed without it. Excluding
# the directory itself would make the negation below unreachable.
`/supabase/*
!/supabase/seed.sql

# Dependencies
node_modules/

# Per-agent git worktrees. A parallel agent works in its own checkout, so
# these directories hold a second copy of the tree. They are never committed.
.worktrees/

# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds (produced locally by `npx expo run:android` — PRD-10 D2)
/android/
/ios/
*.apk
*.aab
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
gradle/
gradlew
gradlew.bat

# Signing and credential material. `docs/ENV.md` names a release keystore
# path, so these are live concerns, not hypotheticals.
*.keystore
*.pem
*.crt
*.cer
*.der
*.pkcs12
google-services.json
GoogleService-Info.plist
secrets.yaml
secrets.yml
secrets.json
.envrc
*.local.env
.envrc

# Test + tooling output
coverage/
*.tsbuildinfo
__pycache__/
*.py[cod]

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logo exploration and build scratch. The shipped assets live in assets/images/;
# this folder is local working material and is not part of the repository.
/design/

# Generated deploy artifacts. api/ is the bundled serverless function and
# static/ is the composed single-root tree; both are produced at deploy time by
# scripts/build/bundle-api.mjs and .github/scripts/compose-static.sh.
/api/
/static/

# Metro/Expo dev-server output. Written wherever `expo start` is run;
# untracked build noise, never part of the repository.
metro.log
metro.err

# Headless-browser verification artefacts (screenshots, DOM dumps, page probes).
.verify/
.vercel

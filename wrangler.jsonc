{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freewhen-api",
  "main": "server/worker.ts",

  // ★ REQUIRED FOR THE DATABASE DRIVER.
  //
  // `pg` needs Workers' Node compatibility layer for `node:net`, `node:buffer`
  // and `node:crypto`. Without it, `new Client()` throws at import.
  "compatibility_flags": ["nodejs_compat"],

  // ★ FOUR DAYS AFTER `nodejs_compat_v2` BECAME THE DEFAULT.
  //
  // From 2026-08-04 onwards both compatibility flags are implied, so this date
  // is deliberately past it — the explicit flag above is then belt-and-braces
  // rather than load-bearing.
  "compatibility_date": "2026-08-08",

  // ★ THE HYPERDRIVE BINDING.
  //
  // The id is a PLACEHOLDER. Create the real one with:
  //
  //   npx wrangler hyperdrive create freewhen-db \
  //     --connection-string="postgres://user:pass@host:5432/dbname"
  //
  // and paste the id below. `localConnectionString` is what `wrangler dev`
  // uses so a developer can run against a local Postgres without a Hyperdrive
  // round-trip.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_YOUR_HYPERDRIVE_ID",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5433/freewhen"
    }
  ],

  // ★ SECRETS ARE NOT IN THIS FILE.
  //
  // `PUBLIC_BASE_URL`, `APP_ORIGIN`, `NESHAN_*_API_KEY` and `ORS_API_KEY` are
  // set with `wrangler secret put` (or `[vars]` for the non-secret ones).
  // Committing a value here would put a credential in the source tree, which is
  // exactly what `gate:secrets` exists to prevent — and a Wrangler config is
  // read by anyone with repo access.
  "vars": {
    "PUBLIC_BASE_URL": "https://REPLACE_WITH_YOUR_WORKER_URL"
  },

  // The API has no static assets: `dist/` is exported separately and served by
  // a static host or CDN (see the Dockerfile header). Adding `assets` here
  // would upload an ~80-file bundle the Worker never reads.
  "observability": {
    "enabled": true
  }
}
